# Database - leave empty to use SQLite (development)
# Set DATABASE_URL for PostgreSQL (production)
#DATABASE_URL=postgresql://user:password@localhost:5432/dbname?sslmode=require

# App
APP_NAME=Orbit CRM API
APP_VERSION=1.0.0
DEBUG=true

# Storage (local directory for file uploads)
UPLOAD_DIR=app/storage

# JWT (future)
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GROQ_API=your_groq_api_key_here
# Email (Hostinger SMTP) - sends new employees their welcome email + temp password
# Fill these in with the real Hostinger mailbox credentials.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=syedhashim@theupmotion.online
SMTP_PASSWORD=
SMTP_FROM_EMAIL=syedhashim@theupmotion.online
SMTP_FROM_NAME=Upmotion Tech
ORBIT_LOGIN_URL=https://orbit-up-motion.vercel.app
